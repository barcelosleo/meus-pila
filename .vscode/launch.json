    "version": "0.2.0",
    "configurations": [
        {
            "name": "API: HTTPS sem browser (Debug)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/MeusPila.Api/bin/Debug/net10.0/MeusPila.Api.dll",
            "cwd": "${workspaceFolder}/src/MeusPila.Api",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7216;http://localhost:5074"
            },
            "stopAtEntry": false,
            "preLaunchTask": "build"
        },
    ]
}