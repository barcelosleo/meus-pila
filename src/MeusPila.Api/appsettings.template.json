{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "{{256-bit-secret-key}}",
    "Issuer": "{{issuer}}",
    "Audience": "{{audience}}",
    "ExpirationTimeH": 1.0
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host={{host}};Port={{port}};Database={{db}};Username={{user}};Password={{password}}"
  }
}
